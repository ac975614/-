#!name=隱藏 Google 打開橫幅
#!desc=關閉 Safari 頂部「在 Google App 中打開」提示（新語法）
#!author=Custom
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google.png

[Rewrite]
# 移除 Google 智慧 App 橫幅相關 Header
request if ${url} ~= /^https?:\/\/(www\.)?google\.[a-z.]+/ then request.header.del("X-Safari-Smart-App-Banner") | request.header.del("x-ios-smart-app-banner")
